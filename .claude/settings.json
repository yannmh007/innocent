{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__github__actions_(get|list)$",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/trim_github.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_log.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
