# What the next Firebase Test Lab run does. Edit and push to run again.
# (2026-10-05: the SurfaceTexture / SurfaceProducer A/B on real phones.)
#
# Physical phones, as "model,android-version". The free (Spark) plan allows
# five physical-device tests a day; each line here is one. The workflow
# writes the full list of models Test Lab has into the results, so this can
# be changed to what Myanmar actually carries.
DEVICES="a25x,34 a03su,33"
# Which release to test: "latest" or a tag such as v1.64.49-362.
APK_TAG=v1.64.49-362
# How long Robo may explore after the scripted part, in seconds.
TIMEOUT=300
# The phone's language for the run (my = Burmese).
LOCALE=my
# What the run does:
#   robo     — the released APK (APK_TAG), crawled by Robo after the script.
#   playback — this branch built as an arm64 lab APK; Test Lab's game loop
#              plays a pushed 720p film three ways (HW copy-back, HW direct,
#              software), ~50 s each, while CpuProbe logs every thread.
#              A25 (Exynos) and A34 (Dimensity, Android 16) draw with Vulkan;
#              A03s (MediaTek on Android 13) with OpenGL ES.
#              Two game-loop scenarios per phone: 1 = SurfaceTexture video
#              output, 2 = SurfaceProducer (1.64.54), same film, same script.
MODE=playback
# Set to an earlier run's id to only collect its results again from Test
# Lab's bucket (BUCKET) — no test is run and no quota is spent. Empty = run.
FETCH_RUN=
BUCKET=test-lab-a83h77c3x52vk-yvsvq7a2052yz
