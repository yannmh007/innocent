<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) replacement for backup_rules.xml. See that file for the
  full reasoning; the short version is that the vault must never leave the
  device by a path the user did not choose.

  This file has TWO sections and both matter:

    <cloud-backup>    Google Drive / Auto Backup. Same risk as pre-12.

    <device-transfer> The "copy your apps to your new phone" flow. This one is
                      easy to miss: it is a SEPARATE channel from cloud backup
                      and it copies far more data. Excluding the vault here is
                      what stops a shop assistant setting up a new handset from
                      cloning the user's hidden files across.

  Everything not excluded still transfers, so settings and history survive.
-->
<data-extraction-rules>
    <!-- adb_key.pk8 / adb_cert.der: audit_adb.md A4. An unencrypted RSA
         private key — the identity adbd remembers after pairing — living in
         the same directory as private_vault/. Excluded from BOTH channels:
         a key that reaches a new handset is wrong, because that handset has
         not paired, exactly as with the device id in v1.63.5. -->
    <cloud-backup>
        <exclude domain="file" path="private_vault" />
        <exclude domain="file" path="intruder_shots" />
        <exclude domain="file" path="adb_key.pk8" />
        <exclude domain="file" path="adb_cert.der" />
        <!-- Premium video this phone has played. Excluded from BOTH channels:
             cloud backup would put the catalogue in a Drive account, and the
             new-phone transfer would clone it onto a handset that has not
             been granted any of it. It is pure cache, so losing it costs a
             download and nothing else. -->
        <exclude domain="file" path="stream_cache" />
        <!-- "Watch offline" downloads: COMPLETE ORIGINALS, not cache pieces.
             Excluded from both channels for the same reason and more of it —
             cloud backup would put the viewer's downloaded library in a Drive
             account, the new-phone transfer would clone it onto a handset
             granted none of it, and either one blows past the per-app backup
             quota and takes the settings and history down with it. -->
        <exclude domain="file" path="offline" />
        <!-- Poster artwork, moved out of the system cache directory so an
             offline catalogue still has its pictures. Excluded from both
             channels for the same reason as the catalogue itself. -->
        <exclude domain="file" path="vh_posters" />
        <!-- The catalogue cached for offline browsing: titles, synopses, row
             structure, album listings. An adult catalogue in readable JSON, so
             cloud backup would put a list of it in a Drive account and the
             new-phone transfer would carry it to a handset that has not signed
             in. Excluded from both channels; it costs one refresh. -->
        <exclude domain="file" path="vh_catalogue" />
        <!-- The key those downloads are encrypted with. Keystore-wrapped, and
             the Keystore is never in a backup, so a restored copy is a blob
             with no key: every sealed film would draw as noise instead of
             saying it can no longer be opened. -->
        <exclude domain="sharedpref" path="mx_offline_crypto_v1" />
        <exclude domain="sharedpref" path="mx_offline_crypto_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="private_vault" />
        <exclude domain="file" path="intruder_shots" />
        <exclude domain="file" path="adb_key.pk8" />
        <exclude domain="file" path="adb_cert.der" />
        <!-- Premium video this phone has played. Excluded from BOTH channels:
             cloud backup would put the catalogue in a Drive account, and the
             new-phone transfer would clone it onto a handset that has not
             been granted any of it. It is pure cache, so losing it costs a
             download and nothing else. -->
        <exclude domain="file" path="stream_cache" />
        <!-- "Watch offline" downloads: COMPLETE ORIGINALS, not cache pieces.
             Excluded from both channels for the same reason and more of it —
             cloud backup would put the viewer's downloaded library in a Drive
             account, the new-phone transfer would clone it onto a handset
             granted none of it, and either one blows past the per-app backup
             quota and takes the settings and history down with it. -->
        <exclude domain="file" path="offline" />
        <!-- Poster artwork, moved out of the system cache directory so an
             offline catalogue still has its pictures. Excluded from both
             channels for the same reason as the catalogue itself. -->
        <exclude domain="file" path="vh_posters" />
        <!-- The catalogue cached for offline browsing: titles, synopses, row
             structure, album listings. An adult catalogue in readable JSON, so
             cloud backup would put a list of it in a Drive account and the
             new-phone transfer would carry it to a handset that has not signed
             in. Excluded from both channels; it costs one refresh. -->
        <exclude domain="file" path="vh_catalogue" />
        <!-- The key those downloads are encrypted with. Keystore-wrapped, and
             the Keystore is never in a backup, so a restored copy is a blob
             with no key: every sealed film would draw as noise instead of
             saying it can no longer be opened. -->
        <exclude domain="sharedpref" path="mx_offline_crypto_v1" />
        <exclude domain="sharedpref" path="mx_offline_crypto_v1.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorage" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
